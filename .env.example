# Local demo is credential-free; demo uploads are never transcribed.
VOXSURE_PROVIDER=demo
SARVAM_API_KEY=
VOXSURE_MAX_UPLOAD_MB=25
VOXSURE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Vite proxy target (used instead of VITE_API_BASE_URL locally).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# For a separately hosted frontend, set the API root URL at build time.
# VITE_API_BASE_URL=
VITE_REPOSITORY_URL=
